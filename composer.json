{
    "name": "mossy2100/quantities",
    "description": "Physical quantity value types with units, dimensional analysis, arithmetic and unit conversion.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "php",
        "quantities",
        "units",
        "unit-conversion",
        "measurement",
        "dimensional-analysis",
        "physics",
        "si-units",
        "physical-constants",
        "currency",
        "money"
    ],
    "authors": [
        {
            "name": "Shaun Moss",
            "email": "mossy2100@gmail.com"
        }
    ],
    "homepage": "https://github.com/mossy2100/PHP-Quantities",
    "support": {
        "issues": "https://github.com/mossy2100/PHP-Quantities/issues",
        "source": "https://github.com/mossy2100/PHP-Quantities"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../Core",
            "options": {
                "symlink": true,
                "versions": {
                    "mossy2100/core": "4.0.1"
                }
            }
        },
        {
            "type": "path",
            "url": "../CodingStandard",
            "options": {
                "symlink": true,
                "versions": {
                    "mossy2100/coding-standard": "2.2.0"
                }
            }
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-intl": "*",
        "ext-simplexml": "*",
        "mossy2100/core": "^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0 || ^12.0",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^4.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "mossy2100/coding-standard": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Mossy2100\\Quantities\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mossy2100\\Quantities\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "fix": "vendor/bin/phpcbf -vp",
        "check": "vendor/bin/phpcs -s",
        "report": "vendor/bin/phpcs -q --report=summary",
        "analyze": "scripts/analyze",
        "test": "scripts/test",
        "coverage": "@php scripts/coverage-check.php",
        "quality": [
            "@fix",
            "@check",
            "@analyze",
            "@test all",
            "@coverage"
        ]
    },
    "extra": {
        "phpcodesniffer-search-depth": 3
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.4.0"
        }
    }
}
