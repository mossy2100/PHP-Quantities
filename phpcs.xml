<?xml version="1.0"?>
<ruleset name="Jumbo">
    <description>Coding standard for the Mossy2100 packages by Shaun Moss.</description>

    <!-- Paths to check -->
    <file>src</file>
    <file>tests</file>

    <!-- Exclude generated data files -->
    <exclude-pattern>src/Currencies/snapshot</exclude-pattern>

    <!-- Use the Jumbo Coding Standard (PER Coding Style 3.1 plus extra rules) -->
    <rule ref="Jumbo"/>
</ruleset>
